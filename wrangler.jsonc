{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hourline",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "countrytime.online", "custom_domain": true },
    { "pattern": "www.countrytime.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  }
}
